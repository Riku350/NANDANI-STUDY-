{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student profile, academic metadata, and study preferences owned strictly by the authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "studentClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "dailyGoalMinutes": {
          "type": "number",
          "description": "Daily study goal in minutes (15 to 960)."
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "dailyReminderTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "studentClass",
        "dailyGoalMinutes",
        "theme",
        "notificationsEnabled",
        "dailyReminderTime",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserSubject": {
      "title": "UserSubject",
      "description": "A Class 12 subject enrolled by the student (Physics, Chemistry, Biology, Zoology, or custom subjects).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "iconKey": {
          "type": "string",
          "enum": ["atom", "flask", "dna", "microscope", "calculator", "book", "globe", "code"]
        },
        "accentColor": {
          "type": "string",
          "enum": ["blue", "amber", "emerald", "rose", "violet", "cyan", "teal", "indigo"]
        },
        "order": {
          "type": "number"
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "iconKey",
        "accentColor",
        "order",
        "isDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChapterProgress": {
      "title": "ChapterProgress",
      "description": "Syllabus chapter belonging to a student's subject with completion state and accumulated study seconds.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterNumber": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "topics": {
          "type": "array",
          "description": "Key subtopics covered in the chapter (max 20)."
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "completed"]
        },
        "totalStudySeconds": {
          "type": "number"
        },
        "completedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "subjectId",
        "chapterNumber",
        "title",
        "topics",
        "status",
        "totalStudySeconds",
        "completedAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Immutable focus study session record used to calculate daily, weekly, monthly, all-time analytics and streaks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chapterTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "durationSeconds": {
          "type": "number"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "startedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "endedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "subjectId",
        "subjectName",
        "chapterId",
        "chapterTitle",
        "durationSeconds",
        "dateKey",
        "monthKey",
        "startedAtIso",
        "endedAtIso",
        "createdAt"
      ]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "PDF study notes, formula sheets, and syllabus documents accessible to the student.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["notes", "syllabus", "formula_sheet", "practice"]
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "fileUrl": {
          "type": "string",
          "maxLength": 500
        },
        "pageCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "subjectId",
        "title",
        "category",
        "description",
        "fileUrl",
        "pageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted admin lookup table for future Admin Panel management.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global study notices managed by admins for Class 12 students.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "body", "active", "createdAt", "updatedAt"]
    },
    "DailyTask": {
      "title": "DailyTask",
      "description": "A student's daily study task scheduled for a specific date with status tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subjectId": {
          "type": "string",
          "maxLength": 64
        },
        "subjectName": {
          "type": "string",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed"]
        },
        "completedAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "taskType": {
          "type": "string",
          "enum": [
            "study_task",
            "revision",
            "question_practice",
            "notes_making",
            "mock_test",
            "assignment",
            "homework",
            "doubt_solving",
            "reading",
            "formula_revision"
          ]
        },
        "chapterTopic": {
          "type": "string",
          "maxLength": 120
        },
        "startTime": {
          "type": "string",
          "maxLength": 10
        },
        "dueTime": {
          "type": "string",
          "maxLength": 10
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "estimatedMinutes": {
          "type": "number"
        },
        "reminderEnabled": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "repeat": {
          "type": "string",
          "enum": ["none", "daily", "weekly"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "dateKey",
        "monthKey",
        "title",
        "subjectId",
        "subjectName",
        "status",
        "completedAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyReview": {
      "title": "DailyReview",
      "description": "A student's daily self-review capturing today's mistakes, improvements, and tomorrow's focus priorities.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "mistakes": {
          "type": "array",
          "description": "List of mistakes noticed during the day's study (max 20)."
        },
        "improvements": {
          "type": "array",
          "description": "List of improvement actions to take next (max 20)."
        },
        "tomorrowFocus": {
          "type": "array",
          "description": "List of key focus targets for the next day (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "dateKey",
        "monthKey",
        "mistakes",
        "improvements",
        "tomorrowFocus",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public, non-PII weekly study ranking record for a student on the Nandani Study Global Leaderboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "studentClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "weekKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "weeklyStudySeconds": {
          "type": "number",
          "description": "Total study seconds logged during the current Monday-Sunday week (0 to 604800)."
        },
        "currentStreak": {
          "type": "number",
          "description": "Student's current consecutive study days streak (0 to 3650)."
        },
        "sessionsCount": {
          "type": "number",
          "description": "Number of study sessions logged during the current week (0 to 500)."
        },
        "visible": {
          "type": "boolean",
          "description": "Whether the student opts in to appear publicly on the Global Leaderboard."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "studentClass",
        "weekKey",
        "weeklyStudySeconds",
        "currentStreak",
        "sessionsCount",
        "visible",
        "createdAt",
        "updatedAt"
      ]
    },
    "AiChatSession": {
      "title": "AiChatSession",
      "description": "Private student AI Study Chat conversation categorized by Class 12 subject.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["Physics", "Chemistry", "Biology", "Zoology", "General Study"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "messages": {
          "type": "array",
          "description": "Bounded list of student and AI study messages (max 60)."
        },
        "lastMessageAtIso": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "category",
        "title",
        "messages",
        "lastMessageAtIso",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student profile and preferences document."
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/UserSubject" },
      "description": "Enrolled subjects for a specific student."
    },
    "/users/{userId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/ChapterProgress" },
      "description": "Chapter syllabus items and completion progress for a student."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Immutable recorded focus study sessions for analytics and streaks."
    },
    "/users/{userId}/materials/{materialId}": {
      "schema": { "$ref": "#/entities/StudyMaterial" },
      "description": "PDF notes and syllabus documents for a student."
    },
    "/users/{userId}/dailyTasks/{taskId}": {
      "schema": { "$ref": "#/entities/DailyTask" },
      "description": "Daily study tasks scheduled per date for a specific student."
    },
    "/users/{userId}/dailyReviews/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyReview" },
      "description": "Daily mistake logs, improvement goals, and tomorrow focus notes per date."
    },
    "/users/{userId}/aiChats/{chatId}": {
      "schema": { "$ref": "#/entities/AiChatSession" },
      "description": "Private saved AI Study Chat conversations categorized by subject."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role registry for future Admin Panel permissions."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Global active announcements visible to students, managed by admins."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public non-PII weekly study rankings for opted-in students."
    }
  }
}
